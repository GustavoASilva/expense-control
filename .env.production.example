# Copy this file to .env.production (or export these vars in CI/CD) before running docker compose.

POSTGRES_DB=ExpenseControlDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_APP_CLIENT_ID=replace-with-app-client-id

# Use a relative API path so the frontend calls through nginx on the same domain.
VITE_API_URL=/api
