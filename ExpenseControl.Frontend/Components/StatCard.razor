@using Microsoft.AspNetCore.Components

<div class="card shadow-sm mb-4 @(Inverted ? "bg-primary text-white" : "")">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="card-subtitle mb-2 @(Inverted ? "text-white-50" : "text-muted")">@Title</h6>
                <h2 class="card-title mb-0">@Value.ToString("C")</h2>
            </div>
            <div class="@(Inverted ? "text-white-50" : "text-muted")">
                <i class="bi @Icon fs-1"></i>
            </div>
        </div>
        @if (ShowChange && PreviousValue.HasValue)
        {
            var previousAbs = Math.Abs(PreviousValue.Value);
            var change = previousAbs > 0 ? ((Value - PreviousValue.Value) / previousAbs) * 100 : 0;
            var isPositive = change > 0;
            <div class="mt-3">
                <small class="@(Inverted ? "text-white-50" : "text-muted")">
                    vs previous period
                    <span class="@(isPositive ? "text-success" : "text-danger")">
                        @(isPositive ? "+" : "")@change.ToString("0.#")%
                    </span>
                </small>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public decimal Value { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-cash";
    [Parameter] public bool Inverted { get; set; }
    [Parameter] public decimal? PreviousValue { get; set; }
    [Parameter] public bool ShowChange { get; set; } = true;
}
