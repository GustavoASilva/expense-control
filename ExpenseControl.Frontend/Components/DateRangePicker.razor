@namespace ExpenseControl.Frontend.Components
@using ExpenseControl.Frontend.Models

<div class="@(Small ? "btn-group btn-group-sm" : "btn-group") mb-3">
    @foreach (var period in _periods)
    {
        <button type="button" 
                class="btn @(IsSelected(period) ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => OnPeriodSelected(period)">
            @period.Label
        </button>
    }
</div>

@code {
    private record struct DatePeriod(string Label, DateTime Start, DateTime End);
    private List<DatePeriod> _periods = new();

    [Parameter]
    public bool Small { get; set; }

    [Parameter]
    public DateTime? StartDate { get; set; }

    [Parameter]
    public DateTime? EndDate { get; set; }

    [Parameter]
    public EventCallback<(DateTime start, DateTime end)> OnChanged { get; set; }

    private async Task OnPeriodSelected(DatePeriod period)
    {
        StartDate = period.Start;
        EndDate = period.End;
        await OnChanged.InvokeAsync((period.Start, period.End));
    }

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        var firstDayOfMonth = new DateTime(today.Year, today.Month, 1);

        _periods = new List<DatePeriod>
        {
            new DatePeriod("Last 7 days", today.AddDays(-6), today),
            new DatePeriod("Last 30 days", today.AddDays(-29), today),
            new DatePeriod("This month", firstDayOfMonth, today),
            new DatePeriod("Last month", firstDayOfMonth.AddMonths(-1), firstDayOfMonth.AddDays(-1)),
            new DatePeriod("Last 3 months", firstDayOfMonth.AddMonths(-2), today),
            new DatePeriod("This year", new DateTime(today.Year, 1, 1), today)
        };
    }

    private bool IsSelected(DatePeriod period) => 
        StartDate?.Date == period.Start.Date && EndDate?.Date == period.End.Date;
}