@page "/transactions/new"
@page "/transactions/{Id:int}"
@using ExpenseControl.Frontend.Models
@using ExpenseControl.Frontend.Services
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "New Transaction" : "Edit Transaction") - Expense Control</PageTitle>

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">@(_isNew ? "New Transaction" : "Edit Transaction")</h1>
            </div>

            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="@_transaction" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="type" id="income" value="@TransactionType.Income"
                                            @onchange="() => OnTransactionTypeChanged(TransactionType.Income)"
                                            checked="@(_transaction.Type == TransactionType.Income)" />
                                        <label class="btn btn-outline-success" for="income">Income</label>

                                        <input type="radio" class="btn-check" name="type" id="expense" value="@TransactionType.Expense"
                                            @onchange="() => OnTransactionTypeChanged(TransactionType.Expense)"
                                            checked="@(_transaction.Type == TransactionType.Expense)" />
                                        <label class="btn btn-outline-danger" for="expense">Expense</label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="amount" class="form-label">Amount</label>
                                    <InputNumber @bind-Value="_transaction.Amount" class="form-control" id="amount" />
                                    <ValidationMessage For="@(() => _transaction.Amount)" />
                                </div>

                                <div class="col-md-6">
                                    <label for="date" class="form-label">Date</label>
                                    <InputDate @bind-Value="_transaction.Date" class="form-control" id="date" />
                                    <ValidationMessage For="@(() => _transaction.Date)" />
                                </div>

                                <div class="col-12">
                                    <label for="description" class="form-label">Description</label>
                                    <InputText @bind-Value="_transaction.Description" class="form-control" id="description" />
                                    <ValidationMessage For="@(() => _transaction.Description)" />
                                </div>

                                <div class="col-12">
                                    <label for="category" class="form-label">Category</label>
                                    <InputSelect @bind-Value="_transaction.CategoryId" class="form-select" id="category">
                                        <option value="">Select a category</option>
                                        @foreach (var category in _categories.Where(c => c.Type == _transaction.Type))
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _transaction.CategoryId)" />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span class="ms-2">Saving...</span>
                                }
                                else
                                {
                                    <span>Save</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _isNew => !Id.HasValue;
    private bool _isLoading = true;
    private bool _isSaving;
    private Transaction _transaction = new() { Date = DateTime.Today, Type = TransactionType.Income };
    private List<Category> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await Api.GetCategoriesAsync();

            if (!_isNew)
            {
                var transaction = await Api.GetTransactionAsync(Id.Value);
                if (transaction != null)
                {
                    _transaction = transaction;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/transactions");
    }

    private async Task HandleValidSubmit()
    {
        if (_isSaving) return;

        try
        {
            _isSaving = true;
            await Api.CreateTransactionAsync(_transaction);
            Navigation.NavigateTo("/transactions");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OnTransactionTypeChanged(TransactionType type)
    {
        _transaction.Type = type;
        _transaction.CategoryId = Guid.Empty; // Reset category selection
    }
}
