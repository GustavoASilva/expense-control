@page "/budgets"
@using ExpenseControl.Frontend.Models
@using ExpenseControl.Frontend.Pages
@using ExpenseControl.Frontend.Components
@using System
@using System.Collections.Generic
@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>Budgets</PageTitle>

<div class="container py-3">
    <h1 class="h3 mb-4">Budgets by Category</h1>
    <button class="btn btn-primary mb-3" @onclick="NavigateToAddBudget">Add Budget</button>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Month</th>
                <th>Year</th>
                <th>Amount</th>
                <th>Usage</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var budget in ExistingBudgets)
            {
                <tr>
                    <td>@budget.CategoryName</td>
                    <td>@budget.Month</td>
                    <td>@budget.Year</td>
                    <td>@budget.Amount.ToString("C")</td>
                    <td>
                        @if (BudgetUsages.TryGetValue(budget.Id, out var usage))
                        {
                            <BudgetUsageCard Budget="budget" Usage="usage" />
                        }
                        else
                        {
                            <span class="text-muted">Loading...</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => NavigateToEditBudget(budget.Id)">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<BudgetModel> ExistingBudgets = new();
    private List<CategoryModel> Categories = new();
    private Dictionary<Guid, BudgetUsageModel> BudgetUsages = new();

    protected override async Task OnInitializedAsync()
    {
        Categories = await Api.GetCategoriesAsync();
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        ExistingBudgets = await Api.GetBudgetsAsync();
        BudgetUsages.Clear();
        foreach (var budget in ExistingBudgets)
        {
            // Fetch usage for each budget
            BudgetUsages[budget.Id] = await Api.GetBudgetUsageAsync(budget.CategoryId, budget.Year, budget.Month);
        }
    }

    private void NavigateToAddBudget() => Navigation.NavigateTo("/budget-form");
    private void NavigateToEditBudget(Guid id) => Navigation.NavigateTo($"/budget-form/{id}");
}