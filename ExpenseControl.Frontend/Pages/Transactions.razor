@page "/transactions"
@using ExpenseControl.Frontend.Models
@using ExpenseControl.Frontend.Services
@using ExpenseControl.Frontend.Components
@inject ApiService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Transactions - Expense Control</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Transactions</h1>
        <div class="d-flex gap-2">
            <DateRangePicker Small="true" StartDate="@_startDate" EndDate="@_endDate" OnChanged="@(range => LoadData(range.start, range.end))" />
            <button class="btn btn-primary btn-sm" @onclick="CreateTransaction">
                <i class="bi bi-plus"></i> New Transaction
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                @if (!_transactions.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1"></i>
                        <p class="mt-2">No transactions found</p>
                        <button class="btn btn-primary" @onclick="CreateTransaction">Create your first transaction</button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th class="text-end">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in _transactions)
                                {
                                    <tr>
                                        <td>@transaction.Date.ToShortDateString()</td>
                                        <td>@transaction.Description</td>
                                        <td>
                                            @transaction.CategoryName
                                        </td>
                                        <td class="text-end">
                                            <span class="@(transaction.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                                @(transaction.Type == TransactionType.Income ? "+" : "-")@transaction.Amount.ToString("C")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => EditTransaction(transaction.Id)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => DeleteTransaction(transaction)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-29));
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.Today);
    private List<TransactionListItemModel> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData(_startDate, _endDate);
    }

    private async Task LoadData(DateOnly start, DateOnly end)
    {
        _isLoading = true;
        _startDate = start;
        _endDate = end;

        try
        {
            _transactions = await Api.GetTransactionsAsync(start, end);
            _transactions = _transactions.OrderByDescending(t => t.Date).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CreateTransaction()
    {
        Navigation.NavigateTo("/transactions/new");
    }

    private void EditTransaction(Guid id)
    {
        Navigation.NavigateTo($"/transactions/{id}");
    }

    private async Task DeleteTransaction(TransactionListItemModel transaction)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this transaction?\n\n{transaction.Description}\n{transaction.Amount:C}"))
        {
            await Api.DeleteTransactionAsync(transaction.Id);
            await LoadData(_startDate, _endDate);
        }
    }
}
